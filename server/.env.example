# AI Trigger vision pipeline (server/ai/vision_pipeline.py). Any OpenAI-
# compatible endpoint works -- defaults to Gemini's own OpenAI-compatible
# endpoint and model if AI_BASE_URL/AI_MODEL are left blank.
AI_API_KEY=

# Uncomment and set these to point at a different OpenAI-compatible
# provider/router instead, e.g. OpenRouter:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-2.0-flash-lite-001
